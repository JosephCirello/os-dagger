# Copy this file to .env and fill in ONE endpoint. Retrieval needs none of this;
# only answer generation (ask.py without --retrieve-only) reads these.

# xAI
DAGGER_BASE_URL=https://api.x.ai/v1
DAGGER_API_KEY=your-key-here
DAGGER_MODEL=grok-4.7

# OpenAI
# DAGGER_BASE_URL=https://api.openai.com/v1
# DAGGER_API_KEY=your-key-here
# DAGGER_MODEL=gpt-5.5

# Anthropic (OpenAI-compatible endpoint)
# DAGGER_BASE_URL=https://api.anthropic.com/v1
# DAGGER_API_KEY=your-key-here
# DAGGER_MODEL=claude-sonnet-5-5

# Local, no key, fully offline (Ollama)
# DAGGER_BASE_URL=http://localhost:11434/v1
# DAGGER_API_KEY=ollama
# DAGGER_MODEL=llama3.1
